# ==============================================================================
# TechMarket BD — Production Environment Configuration (.env)
# Domain: techmarket.com.bd
# ==============================================================================

APP_NAME="TechMarket BD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://techmarket.com.bd

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_MAX_FILES=14

# Database Configuration (MySQL on aaPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techmarket_db
DB_USERNAME=techmarket_user
DB_PASSWORD=your_secure_db_password

# Session & Cache Drivers (Redis Caching on aaPanel)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_STORE=redis
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
CACHE_PREFIX=tmb_cache_

# Queue Connection (Redis background queues)
QUEUE_CONNECTION=redis

# Redis Configuration (aaPanel phpredis native extension)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_PREFIX=techmarket_

# Filesystem (Local public storage on aaPanel or AWS S3)
FILESYSTEM_DISK=public

# Mail Configuration (SMTP / Brevo / SendGrid / SES)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@techmarket.com.bd
MAIL_PASSWORD=your-email-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@techmarket.com.bd"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend App Name
VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# Payment Gateways (Bangladesh)
# ==============================================================================

# bKash Checkout
BKASH_ENVIRONMENT=live
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta

# Nagad Direct Payment
NAGAD_ENVIRONMENT=live
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs

# SSLCommerz Hosted Gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=true

# ==============================================================================
# Courier & SMS Gateways (Configurable via Admin UI as well)
# ==============================================================================

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
