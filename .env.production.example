# ==============================================================================
# TechMarket BD - Production Environment Configuration (.env)
# ==============================================================================

APP_NAME="TechMarket BD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / MariaDB on Live Server)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_production_db
DB_USERNAME=your_production_user
DB_PASSWORD=your_secure_production_password

# ------------------------------------------------------------------------------
# Session, Cache & Queue (Redis Recommended for High Traffic, or Database)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Mail / SMTP Configuration (for Order Invoices & Customer Notifications)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="TechMarket BD"

# ------------------------------------------------------------------------------
# Payment Gateways (Live / Sandbox)
# ------------------------------------------------------------------------------
# SSLCommerz Live Credentials
SSLCZ_STORE_ID=your_live_store_id
SSLCZ_STORE_PASSWORD=your_live_store_password
SSLCZ_TEST_MODE=false

# bKash Direct Checkout Credentials
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_SANDBOX=false

# ------------------------------------------------------------------------------
# SMS Gateways (Steadfast / BulkSMSBD / MimSMS / ElitBuzz / Greenweb)
# ------------------------------------------------------------------------------
DEFAULT_SMS_GATEWAY=bulksmsbd
BULKSMSBD_API_KEY=your_bulksmsbd_api_key
BULKSMSBD_SENDER_ID=your_approved_sender_id

# ------------------------------------------------------------------------------
# Courier Automated Integration (Steadfast / Pathao / RedX / Paperfly)
# ------------------------------------------------------------------------------
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_email
PATHAO_PASSWORD=your_pathao_password
